PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/odishavirtual
CLIENT_ORIGIN=http://localhost:5173

# Groq powers the AI assistant. Without a key, chat falls back to the rule-based guide.
# Get a key at https://console.groq.com/keys. Check current model IDs at https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Signs login cookies. Use a long random value (at least 32 characters) in production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_DAYS=7
# Comma-separated emails allowed to be admins. Admin accounts are created on the unlisted
# staff page (client route set by VITE_STAFF_PATH), which also needs ADMIN_SIGNUP_CODE.
ADMIN_EMAILS=you@example.com
# Optional extra secret staff must enter to create an admin account. Empty = not required.
ADMIN_SIGNUP_CODE=

# Sent with every request to OpenStreetMap / Wikimedia services (their usage policies require a contact).
PROVIDER_CONTACT=you@example.com

# Optional overrides for self-hosted or paid providers
OSRM_URL=https://router.project-osrm.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

CHAT_RATE_LIMIT_PER_15_MIN=30
